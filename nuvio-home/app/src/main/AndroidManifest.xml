<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Nuvio's public API, your addons and their artwork. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lists the apps that show on a TV home screen, for the Applications page. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="nuvio" />
        </intent>
        <package android:name="com.nuvio.tv" />
        <package android:name="com.nuvio.app" />
    </queries>
    <application
        android:label="Nuvio Clean TV"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:theme="@style/Home"
        android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Lets the TV offer this app as its home screen once it is ready (phase 2). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".SignInActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".FolderActivity" android:exported="false" />
        <activity android:name=".DetailActivity" android:exported="false" />
        <activity android:name=".PersonActivity" android:exported="false" />
    </application>
</manifest>
